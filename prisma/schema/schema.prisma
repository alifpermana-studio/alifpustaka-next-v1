generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @db.Timestamptz(3)
  updatedAt             DateTime  @db.Timestamptz(3)
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model audit_log {
  id              String   @id
  action          String
  entityType      String
  entityId        String
  performedBy     String
  performedByRole String
  oldValue        String?
  newValue        String?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([performedBy])
}

model discussion {
  id                String       @id
  content           String
  status            String       @default("pending")
  sourceType        String
  sourceId          String
  userId            String
  parentId          String?
  editedAt          DateTime?    @db.Timestamptz(3)
  editCount         Int          @default(0)
  deletedAt         DateTime?    @db.Timestamptz(3)
  permanentDeleteAt DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @db.Timestamptz(3)
  discussion        discussion?  @relation("discussionTodiscussion", fields: [parentId], references: [id], onDelete: Cascade)
  other_discussion  discussion[] @relation("discussionTodiscussion")
  user              user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([parentId])
  @@index([permanentDeleteAt])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([userId])
}

model gallery {
  id         String   @id
  title      String
  slug       String   @unique
  size       Int
  format     String
  path       String
  type       String
  tags       String[]
  uploadTime DateTime @default(now()) @db.Timestamptz(3)
  isPrivate  Boolean  @default(false)
  isFeatured Boolean  @default(false)
  userId     String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  footnote   String?
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model notification {
  id                String    @id
  userId            String
  type              String
  title             String
  message           String
  linkTo            String?
  relatedEntityType String?
  relatedEntityId   String?
  isRead            Boolean   @default(false)
  readAt            DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  user              user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model post {
  id         String     @id
  title      String
  desc       String?
  slug       String     @unique
  image      String
  footnote   String
  status     String     @default("drafted")
  content    String
  userId     String
  uploadTime DateTime   @default(now()) @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @db.Timestamptz(3)
  user       user       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post_tag   post_tag[]
}

model post_tag {
  postId String
  tagId  String
  post   post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)
  role      String?
  user      user     @relation(fields: [userId], references: [id])
}

model tag {
  id        String     @id
  name      String     @unique
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @db.Timestamptz(3)
  post_tag  post_tag[]
}

model user {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime       @db.Timestamptz(3)
  updatedAt     DateTime       @db.Timestamptz(3)
  username      String         @unique
  role          String         @default("user")
  status        String         @default("active")
  account       account[]
  discussion    discussion[]
  gallery       gallery[]
  notification  notification[]
  post          post[]
  session       session[]
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
}
